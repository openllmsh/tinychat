# Nothing here is required: run `bun dev` and paste an OpenLLM API key in the app.
#
# Optional: "Connect with OpenLLM" (OAuth), so each visitor signs in with their
# own OpenLLM account. Create an app in OpenLLM → Settings → Developers → Apps,
# register http://localhost:3005/callback as a callback URL, and paste the app's
# .env block below.
OPENLLM_CLIENT_ID=
OPENLLM_CLIENT_SECRET=
OPENLLM_PRIVATE_KEY=
OPENLLM_ISSUER=
OPENLLM_RESOURCE=https://openllm.sh/v1
OPENLLM_REDIRECT_URI=http://localhost:3005/callback
CONNECTION_SECRET=   # openssl rand -base64 32

OPENLLM_API_ORIGIN=https://www.openllm.sh
