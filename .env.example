# Paste the .env block from OpenLLM → Settings → Developers → Apps → <your app>.
# Register http://localhost:3005/callback as one of the app's callback URLs.
OPENLLM_CLIENT_ID=
OPENLLM_CLIENT_SECRET=
OPENLLM_PRIVATE_KEY=
OPENLLM_ISSUER=
OPENLLM_RESOURCE=https://openllm.sh/v1
OPENLLM_API_ORIGIN=https://openllm.sh
OPENLLM_REDIRECT_URI=http://localhost:3005/callback
CONNECTION_SECRET=   # openssl rand -base64 32
